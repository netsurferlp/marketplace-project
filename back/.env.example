# ================================================
# 1. CONFIGURACION DEL SERVIDOR EXPRESS
# ================================================
PORT=
NODE_ENV=
# URL de tu aplicacion en React(Vite) para configurar los CORS
FRONTEND_URL=
# ===============================================
# 2. CONEXION A LA BASE DE DATOS MYSQL
# ===============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# ===============================================
# 3. SEGURIDAD Y SESION (JWT & COOKIES)
# ===============================================
# Clave secreta para firmar los tokens JWT (debe ser una cadena larga y compleja)
JWT_SECRET=
JWT_EXPIRES_IN=

# Clave opcional parea firmar cookies si usas cookie-parser con firma 
COOKIE_SECRET=
# ===============================================
# 4. AUTENTICACION CON GOOGLE (OAUTH 2.0)
# ===============================================
#Obtenido desde Google Cloud Console
GOOGLE_CLIENT_ID=
